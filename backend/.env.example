# Backend environment variables — copy to .env for local development.
# .env is git-ignored. Never commit actual credentials.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, works immediately without external server):
DATABASE_URL=sqlite:///./vpn_analyzer.db

# PostgreSQL (required for persistent storage on Render/Railway/etc.):
# DATABASE_URL=postgresql://vpnanalyzer:password@host:5432/vpn_analyzer

# ── File storage ─────────────────────────────────────────────────────────────
# Directory where uploaded PCAP files are saved.
# NOTE: on Render's free tier the filesystem is ephemeral — files are lost
#       on every redeploy. Use a persistent disk or S3-compatible store for
#       production workloads that need PCAP files to survive restarts.
PCAP_STORAGE_DIR=./pcap_storage

# ── ML model ─────────────────────────────────────────────────────────────────
# Path to the trained protocol_classifier.joblib file.
# If the file does not exist, the app gracefully falls back to a heuristic
# classifier — no crash, but confidence scores will be lower (0.55 cap).
MODEL_PATH=./ml_models/protocol_classifier.joblib
