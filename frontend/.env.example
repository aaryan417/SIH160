# Frontend environment variables
# Copy this file to .env for local development (already git-ignored).

# URL of the FastAPI backend.
# LOCAL DEVELOPMENT: leave as http://localhost:8000
VITE_API_URL=http://localhost:8000

# PRODUCTION (Vercel):
# Set VITE_API_URL in Vercel → Project → Settings → Environment Variables
# to the public HTTPS URL of your deployed FastAPI backend, e.g.:
# VITE_API_URL=https://vpn-analyzer-api.onrender.com
